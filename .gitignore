# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
.pub-cache/
.pub/
pubspec.lock

# IDE
.idea/
.vscode/
*.iml

# 平台工程：android/ 包含本地原生定制（相机 FileProvider 等），随仓库提交；
# windows/、linux/ 仍由 flutter create 生成（无本地定制），继续忽略。
/windows/
/linux/
.gradle/
/macos/
/ios/
/web/

# flutter create 补齐的模板测试（引用模板类 MyApp，不适用于本项目；
# CI 里也会在跑 analyze / test 之前显式删除）
/test/widget_test.dart

# 打包产物
*.zip
*.zbk
/dist/

# 装配出来的 WebView2 固定版本运行时（约 174 MiB，绝不入库）
build_kernel_pkg/*/runtime/

# Python 缓存（tool/*.py 之间互相 import 会生成 tool/__pycache__/）
__pycache__/
*.pyc

# 系统
.DS_Store
Thumbs.db

# Flutter 元数据（本地工具生成，勿提交）
.metadata
